    {
      "id": "slice.market_shift",
      "kind": "flow",
      "revision": 1,
      "scope": "company",
      "trigger": {
        "all_of": [
          {
            "fact": "company.has_enterprise_segment",
            "op": "eq",
            "value": true
          },
          {
            "fact": "company.market_shift_active",
            "op": "eq",
            "value": false
          }
        ]
      },
      "lifecycle": {
        "mode": "interval",
        "every": {
          "unit": "days",
          "value": 90
        },
        "max_occurrences_per_scope": 12,
        "miss_policy": "skip",
        "anchor": {
          "kind": "campaign_start",
          "offset": {
            "unit": "days",
            "value": 45
          },
          "invalid_day": "clamp_to_month_end"
        }
      },
      "entry_node": "sample",
      "nodes": {
        "sample": {
          "kind": "random",
          "stream": "markets",
          "branches": [
            {
              "id": "no_event",
              "weight": 2,
              "next": "end"
            },
            {
              "id": "increase",
              "weight": 1,
              "next": "increase"
            },
            {
              "id": "decrease",
              "weight": 1,
              "next": "decrease"
            }
          ]
        },
        "increase": {
          "kind": "effect",
          "effects": [
            {
              "op": "temporary_demand_change",
              "target": "self",
              "segment_id": "segment.enterprise",
              "delta_bp": 2000,
              "duration_days": 30
            }
          ],
          "next": "up_news"
        },
        "decrease": {
          "kind": "effect",
          "effects": [
            {
              "op": "temporary_demand_change",
              "target": "self",
              "segment_id": "segment.enterprise",
              "delta_bp": -2000,
              "duration_days": 30
            }
          ],
          "next": "down_news"
        },
        "up_news": {
          "kind": "news",
          "text_key": "slice.demand.increase",
          "next": "wait"
        },
        "down_news": {
          "kind": "news",
          "text_key": "slice.demand.decrease",
          "next": "wait"
        },
        "wait": {
          "kind": "delay",
          "next": "expired",
          "duration_days": 30
        },
        "expired": {
          "kind": "news",
          "text_key": "slice.demand.expired",
          "next": "end"
        },
        "end": {
          "kind": "end"
        }
      },
      "tags": [
        "base_event",
        "slice"
      ]
    },
