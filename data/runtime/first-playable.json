                "op": "eq",
                "value": true
              },
              {
                "fact": "company.in_liquidity_workout",
                "op": "eq",
                "value": true
              }
            ]
          }
        ]
      },
      "lifecycle": {
        "mode": "once",
        "max_occurrences_per_scope": 1
      },
