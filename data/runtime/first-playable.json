      "entry_node": "sample",
      "nodes": {
        "sample": {
          "kind": "random",
          "stream": "markets",
          "branches": [
            {
              "id": "no_event",
              "weight": 1,
              "next": "end"
            },
            {
              "id": "offer",
              "weight": 1,
              "next": "choice"
            }
          ]
        },
        "choice": {
          "kind": "dialogue",
          "title_key": "slice.supplier.title",
          "text_key": "slice.supplier.text",
          "default_choice_if_dismissed": "decline",
          "choices": [
            {
              "id": "accept",
              "label_key": "slice.supplier.accept",
              "next": "accept"
            },
            {
              "id": "decline",
              "label_key": "slice.supplier.decline",
              "next": "end"
            }
          ]
        },
        "accept": {
          "kind": "effect",
          "effects": [
            {
              "op": "accept_business_offer",
              "target": "self",
              "offer_id": "offer.supplier_small"
            }
          ],
          "next": "result"
