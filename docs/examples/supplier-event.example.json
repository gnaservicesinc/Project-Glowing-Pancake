{
  "example_only": true,
  "format_version": 1,
  "id": "flow.supplier.exclusivity_offer",
  "revision": 1,
  "scope": "company",
  "tags": [
    "finance",
    "compute",
    "governance",
    "opportunity"
  ],
  "trigger": {
    "all_of": [
      {
        "fact": "company.monthly_compute_bill_cents",
        "op": "gte",
        "value": 2000000
      },
      {
        "fact": "company.has_exclusive_compute_supplier",
        "op": "eq",
        "value": false
      }
    ]
  },
  "lifecycle": {
    "mode": "once",
    "occurrence_scope": "company",
    "max_occurrences_per_scope": 1,
    "overlap": "forbid"
  },
  "entry_node": "offer",
  "nodes": {
    "offer": {
      "kind": "dialogue",
      "title_key": "supplier.exclusivity.title",
      "text_key": "supplier.exclusivity.offer",
      "draft_title": "Capacity with conditions",
      "draft_text": "A supplier offers a 40% compute discount for a three-year minimum purchase, exclusivity, and a non-voting board observer. Reviewing terms does not sign a contract.",
      "choices": [
        {
          "id": "review",
          "label": "Review the proposed contract",
          "next": "review_effect"
        },
        {
          "id": "counteroffer",
          "label": "Propose a smaller commitment and an exit clause",
          "next": "counter_effect"
        },
        {
          "id": "decline",
          "label": "Keep the current supplier terms",
          "next": "decline_effect"
        }
      ],
      "default_choice_if_dismissed": "decline"
    },
    "review_effect": {
      "kind": "effect",
      "effects": [
        {
          "op": "open_negotiation",
          "template_id": "deal.compute_exclusivity"
        }
      ],
      "next": "review_result"
    },
    "review_result": {
      "kind": "result",
      "text_key": "supplier.exclusivity.review_result",
      "draft_text": "Negotiation opened. No contract was signed and no payment was made.",
      "show_committed_changes": true,
      "next": "end"
    },
    "counter_effect": {
      "kind": "effect",
      "effects": [
        {
          "op": "open_negotiation",
          "template_id": "deal.compute_flexible_counteroffer"
        }
      ],
      "next": "counter_result"
    },
    "counter_result": {
      "kind": "result",
      "text_key": "supplier.exclusivity.counter_result",
      "draft_text": "A flexible counteroffer is ready to negotiate. Your current obligations have not changed.",
      "show_committed_changes": true,
      "next": "end"
    },
    "decline_effect": {
      "kind": "effect",
      "effects": [
        {
          "op": "record_decision",
          "value": "declined_exclusivity"
        }
      ],
      "next": "decline_result"
    },
    "decline_result": {
      "kind": "result",
      "text_key": "supplier.exclusivity.decline_result",
      "draft_text": "Offer declined. The existing compute agreement continues.",
      "show_committed_changes": true,
      "next": "end"
    },
    "end": {
      "kind": "end"
    }
  },
  "proposed_terms": {
    "discount_basis_points": 4000,
    "duration_months": 36,
    "take_or_pay": true,
    "exclusive": true,
    "board_observer_without_vote": true
  },
  "commitment_rule": "Only a later confirmed negotiation may create the supplier contract."
}
