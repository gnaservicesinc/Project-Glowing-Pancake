{
  "example_only": true,
  "format_version": 1,
  "note": "Illustrative graph/lifecycle contracts, not a complete registered production catalog. End nodes finish a segment; a continuous instance remains active until its lifecycle exits.",
  "flows": [
    {
      "id": "flow.news.first_public_breakthrough",
      "revision": 1,
      "scope": "world",
      "trigger": {
        "all_of": [
          {
            "fact": "world.public_breakthrough_count",
            "op": "gte",
            "value": 1
          }
        ]
      },
      "lifecycle": {
        "mode": "once",
        "occurrence_scope": "world",
        "max_occurrences_per_scope": 1
      },
      "entry_node": "news",
      "nodes": {
        "news": {
          "kind": "news",
          "text_key": "flow.news.first_public_breakthrough.text",
          "draft_text": "A new research result is now available for evaluation.",
          "next": "end"
        },
        "end": {
          "kind": "end"
        }
      }
    },
    {
      "id": "flow.hidden.compute_review",
      "revision": 1,
      "scope": "company",
      "trigger": {
        "all_of": [
          {
            "fact": "company.has_compute_lease",
            "op": "eq",
            "value": true
          }
        ]
      },
      "lifecycle": {
        "mode": "recurring",
        "repeat_policy": "after_cooldown_while_eligible",
        "cooldown_days": 90,
        "max_occurrences_per_scope": 4,
        "overlap": "forbid"
      },
      "entry_node": "record_review",
      "nodes": {
        "record_review": {
          "kind": "effect",
          "effects": [
            {
              "op": "record_decision",
              "value": "compute_review_due",
              "target": "self"
            }
          ],
          "next": "end"
        },
        "end": {
          "kind": "end"
        }
      }
    },
    {
      "id": "flow.news.monthly_operations",
      "revision": 1,
      "scope": "company",
      "trigger": {
        "all_of": [
          {
            "fact": "company.is_operating",
            "op": "eq",
            "value": true
          }
        ]
      },
      "lifecycle": {
        "mode": "interval",
        "every": {
          "unit": "calendar_months",
          "value": 1
        },
        "max_occurrences_per_scope": 12,
        "miss_policy": "skip",
        "anchor": {
          "kind": "scope_created",
          "offset": {
            "unit": "calendar_months",
            "value": 1
          },
          "invalid_day": "clamp_to_month_end"
        }
      },
      "entry_node": "news",
      "nodes": {
        "news": {
          "kind": "news",
          "text_key": "flow.news.monthly_operations.text",
          "draft_text": "The monthly operations summary is ready.",
          "next": "end"
        },
        "end": {
          "kind": "end"
        }
      }
    },
    {
      "id": "flow.news.scheduled_partner_review",
      "revision": 1,
      "scope": "company",
      "trigger": {
        "all_of": [
          {
            "fact": "company.has_research_partner",
            "op": "eq",
            "value": true
          }
        ]
      },
      "lifecycle": {
        "mode": "scheduled",
        "due_date": "2014-06-01",
        "miss_policy": "skip",
        "max_occurrences_per_scope": 1
      },
      "entry_node": "news",
      "nodes": {
        "news": {
          "kind": "news",
          "text_key": "flow.news.scheduled_partner_review.text",
          "draft_text": "Your research partnership review is due.",
          "next": "end"
        },
        "end": {
          "kind": "end"
        }
      }
    },
    {
      "id": "flow.hidden.sustained_workload",
      "revision": 1,
      "scope": "company",
      "trigger": {
        "all_of": [
          {
            "fact": "company.workload_stress_basis_points",
            "op": "gte",
            "value": 7000
          }
        ]
      },
      "lifecycle": {
        "mode": "continuous",
        "exit_when": {
          "all_of": [
            {
              "fact": "company.workload_stress_basis_points",
              "op": "lte",
              "value": 5000
            }
          ]
        },
        "stacking": "one_per_scope",
        "allow_reentry": true
      },
      "entry_node": "enter",
      "exit_node": "exit",
      "nodes": {
        "enter": {
          "kind": "effect",
          "effects": [
            {
              "op": "register_owned_modifier",
              "key": "sustained_workload",
              "field": "research_coordination_basis_points",
              "add_basis_points": -500,
              "target": "self"
            }
          ],
          "next": "end"
        },
        "exit": {
          "kind": "effect",
          "effects": [
            {
              "op": "remove_owned_modifier",
              "key": "sustained_workload",
              "target": "self"
            }
          ],
          "next": "end"
        },
        "end": {
          "kind": "end"
        }
      }
    },
    {
      "id": "flow.hidden.sequence_resume",
      "revision": 1,
      "scope": "company",
      "trigger": {
        "all_of": [
          {
            "fact": "company.is_operating",
            "op": "eq",
            "value": true
          }
        ]
      },
      "lifecycle": {
        "mode": "once",
        "occurrence_scope": "company",
        "max_occurrences_per_scope": 1
      },
      "entry_node": "outer_sequence",
      "nodes": {
        "outer_sequence": {
          "kind": "sequence",
          "children": [
            "inner_sequence",
            "record_outer"
          ],
          "next": "complete"
        },
        "inner_sequence": {
          "kind": "sequence",
          "children": [
            "wait",
            "record_inner"
          ],
          "next": "inner_return"
        },
        "wait": {
          "kind": "delay",
          "duration_days": 14,
          "next": "wait_return"
        },
        "wait_return": {
          "kind": "end"
        },
        "record_inner": {
          "kind": "effect",
          "effects": [
            {
              "target": "self",
              "op": "record_decision",
              "value": "inner_done"
            }
          ],
          "next": "inner_branch_return"
        },
        "inner_branch_return": {
          "kind": "end"
        },
        "inner_return": {
          "kind": "end"
        },
        "record_outer": {
          "kind": "effect",
          "effects": [
            {
              "target": "self",
              "op": "record_decision",
              "value": "outer_done"
            }
          ],
          "next": "outer_return"
        },
        "outer_return": {
          "kind": "end"
        },
        "complete": {
          "kind": "end"
        }
      },
      "saved_instance_example": {
        "definition_revision": 1,
        "captured_scope": "company.example",
        "current_node": "wait",
        "delay": {
          "due_date": "2014-01-15",
          "resume_node": "wait_return"
        },
        "continuation_stack": [
          {
            "sequence_node": "outer_sequence",
            "next_child_index": 1,
            "return_node": "complete",
            "context": {
              "self": "company.example"
            }
          },
          {
            "sequence_node": "inner_sequence",
            "next_child_index": 1,
            "return_node": "inner_return",
            "context": {
              "self": "company.example"
            }
          }
        ],
        "index_base": 0,
        "expected_effect_order_after_resume": [
          "inner_done",
          "outer_done"
        ],
        "expected_occurrences_each": 1,
        "maximum_continuation_frames": 8,
        "evidence_note": "Illustrative saved stack at the first delayed child; no runtime has executed it."
      }
    }
  ]
}
